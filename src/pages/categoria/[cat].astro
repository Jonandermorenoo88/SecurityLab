---
import { url } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { CATEGORIES, type CategoryKey } from '../../config';
import { getRecursos } from '../../lib/recursos';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((cat) => ({ params: { cat } }));
}

const key = Astro.params.cat as CategoryKey;
const cat = CATEGORIES[key];
const recursos = (await getRecursos()).filter((r) => r.data.category === key);
---

<BaseLayout title={cat.name} description={`${cat.name}: ${cat.description}.`}>
  <section class="container head">
    <div class="icon"><Icon name={cat.icon} size={44} strokeWidth={1.5} /></div>
    <div>
      <p class="eyebrow">Categoría</p>
      <h1>{cat.name}</h1>
      <p class="sub">{cat.description}</p>
    </div>
  </section>

  <section class="container">
    {
      recursos.length > 0 ? (
        <div class="cards">
          {recursos.map((entry) => <ResourceCard entry={entry} />)}
        </div>
      ) : (
        <div class="empty">
          <Icon name={cat.icon} size={34} />
          <p>Todavía no hay recursos en esta categoría. ¡Pronto!</p>
          <a href={url('/recursos/')} class="btn btn-ghost">Ver todos los recursos</a>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .head {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 56px;
    margin-bottom: 36px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    color: var(--accent-2);
    box-shadow: 0 0 30px -8px rgba(43, 212, 245, 0.5);
  }

  h1 {
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 800;
    margin: 6px 0 6px;
  }

  .sub {
    color: var(--text-2);
    font-size: 18px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 64px 20px;
    color: var(--muted);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: center;
  }

  @media (max-width: 1100px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
    .head { flex-direction: column; align-items: flex-start; }
  }
</style>
