---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Noticias" description="Noticias y novedades de ciberseguridad. Próximamente.">
  <section class="container soon grid-bg">
    <div class="icon"><Icon name="newspaper" size={46} strokeWidth={1.5} /></div>
    <p class="eyebrow">Noticias</p>
    <h1>Coming <span>soon</span></h1>
    <p class="sub">
      Estoy preparando una sección con noticias y novedades de ciberseguridad.
    </p>
    <div class="term" aria-hidden="true">
      <span class="p">$</span> ./noticias --status<br />
      <span class="w">[*] En construcción…</span><span class="cursor"></span>
    </div>
  </section>
</BaseLayout>

<style>
  .soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    margin-top: 56px;
    padding-block: 72px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg-2);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    margin-bottom: 8px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    color: var(--accent-2);
    box-shadow: 0 0 34px -8px rgba(43, 212, 245, 0.55);
  }

  h1 {
    font-size: clamp(44px, 8vw, 76px);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  h1 span {
    color: var(--accent-2);
    text-shadow: 0 0 40px rgba(43, 212, 245, 0.35);
  }

  .sub {
    max-width: 52ch;
    color: var(--text-2);
    font-size: 18px;
  }

  .term {
    margin: 12px 0 10px;
    padding: 14px 22px;
    text-align: left;
    font: 14px/1.8 var(--mono);
    color: var(--text-2);
    background: rgba(8, 18, 34, 0.92);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
  }

  .p { color: var(--accent-2); }
  .w { color: var(--amber); }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    margin-left: 6px;
    vertical-align: -3px;
    background: var(--accent-2);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }
</style>
