---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';

// Edita libremente estos textos
const skills = ['ISO 27001', 'ISO 22301', 'NIST CSF', 'ENS', 'NIS2', 'Análisis de riesgos', 'Wireshark', 'Análisis de PCAP', 'Forense Android (ALEAPP)', 'Threat Intelligence', 'VirusTotal / ANY.RUN', 'Linux (Parrot OS)', 'Azure'];

const timeline = [
  { when: 'Abr 2026 – Sept 2026', what: 'Consultor de ciberseguridad (GRC)', where: 'EY' },
  { when: 'Sept 2024 – Mar 2026', what: 'Consultor de ciberseguridad junior (GRC)', where: 'Cipherbit – Grupo Oesía' },
  { when: '2020', what: 'Administrador de servidores', where: 'Clantic' },
];

const formacion = [
  'Máster en Ciberseguridad — UNIR (en curso)',
  'Grado en Ingeniería Informática — Universidad de Burgos',
  'CFGS Administración de Sistemas Informáticos en Red (ASIR)',
  'CFGS Desarrollo de Aplicaciones Web (DAW)',
];
---

<BaseLayout title="Sobre mí" description={`Quién es ${SITE.fullName} y por qué existe este Security Lab.`}>
  <section class="container about">
    <div class="intro">
      <p class="eyebrow">Sobre mí</p>
      <h1>Hola, soy <span>{SITE.author}</span></h1>
      <p class="lead">
        Consultor de ciberseguridad con experiencia en GRC (gobierno, riesgo y cumplimiento) que
        está dando el salto al <strong>Blue Team</strong>. Aquí documento cada laboratorio que
        resuelvo —de CyberDefenders, Blue Team Labs Online o montados por mí— para afianzar lo que
        aprendo y dejar constancia del proceso.
      </p>
      <p class="lead">
        Me interesan el análisis de tráfico, el forense digital, la respuesta a incidentes y la
        threat intelligence. Busco mi primera oportunidad en un <strong>SOC</strong>, en Bizkaia o
        en remoto.
      </p>
      <div class="cta">
        <a href={SITE.links.linkedin} target="_blank" rel="noopener" class="btn btn-primary">
          <Icon name="linkedin" size={19} /> LinkedIn
        </a>
        <a href={SITE.links.github} target="_blank" rel="noopener" class="btn btn-ghost">
          <Icon name="github" size={19} /> GitHub
        </a>
      </div>
    </div>

    <div class="cols">
      <div class="box">
        <h2><Icon name="monitor" size={18} /> Experiencia</h2>
        <ol class="timeline">
          {
            timeline.map((t) => (
              <li>
                <span class="when">{t.when}</span>
                <strong>{t.what}</strong>
                <span class="where">{t.where}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="box">
        <h2><Icon name="book" size={18} /> Formación</h2>
        <ul class="list">{formacion.map((f) => <li>{f}</li>)}</ul>
        <h2 class="mt"><Icon name="wrench" size={18} /> Conocimientos</h2>
        <ul class="chips">{skills.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-top: 56px;
  }

  .intro {
    max-width: 760px;
  }

  h1 {
    font-size: clamp(36px, 5.5vw, 56px);
    font-weight: 800;
    margin: 10px 0 20px;
  }

  h1 span {
    color: var(--accent-2);
  }

  .lead {
    font-size: 18.5px;
    color: var(--text-2);
    line-height: 1.7;
  }

  .lead + .lead {
    margin-top: 14px;
  }

  .lead strong {
    color: var(--text);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 56px;
  }

  .box {
    padding: 26px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .box h2 {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 18px;
    margin-bottom: 18px;
  }

  .box h2 :global(svg) {
    color: var(--accent-2);
  }

  .mt {
    margin-top: 28px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 18px;
    border-left: 2px solid var(--border-strong);
  }

  .timeline li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-bottom: 20px;
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -25px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent-2);
  }

  .when {
    font: 12.5px var(--mono);
    color: var(--accent-2);
  }

  .where {
    color: var(--muted);
    font-size: 15px;
  }

  .list {
    margin: 0;
    padding-left: 1.2em;
    color: var(--text-2);
  }

  .list li + li {
    margin-top: 6px;
  }

  .list li::marker {
    color: var(--accent-2);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chips li {
    padding: 4px 11px;
    font-size: 13.5px;
    border-radius: 8px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-2);
  }

  @media (max-width: 800px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
