---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES } from '../../config';
import { getRecursos, formatDate, readingTime, TYPE_ICON, TYPE_LABEL, type Recurso } from '../../lib/recursos';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const recursos = await getRecursos();
  return recursos.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: recursos[i - 1], older: recursos[i + 1] },
  }));
}

interface Props {
  entry: Recurso;
  newer?: Recurso;
  older?: Recurso;
}

const { entry, newer, older } = Astro.props;
const d = entry.data;
const cat = CATEGORIES[d.category];
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const diffClass = { Fácil: 'badge-easy', Medio: 'badge-medium', Difícil: 'badge-hard' }[d.difficulty];
---

<BaseLayout title={d.title} description={d.description}>
  <article>
    <header class="post-head grid-bg">
      <div class="container">
        <nav class="crumbs" aria-label="Ruta">
          <a href="/recursos/">Recursos</a>
          <span>/</span>
          <a href={`/categoria/${d.category}/`}>{cat.name}</a>
        </nav>

        <div class="badges">
          <span class:list={['badge', d.type === 'guia' ? 'badge-guide' : 'badge-lab']}>
            <Icon name={TYPE_ICON[d.type]} size={15} />{TYPE_LABEL[d.type]}
          </span>
          {d.type === 'laboratorio' && <span class="badge"><Icon name="shield-check" size={15} />{d.platform}</span>}
          <span class:list={['badge', diffClass]}>{d.difficulty}</span>
          {d.draft && <span class="badge draft">Borrador</span>}
        </div>

        <h1>{d.title}</h1>
        <p class="desc">{d.description}</p>

        <div class="meta">
          <span><Icon name="calendar" size={17} />{formatDate(d.date)}</span>
          {d.updated && <span>Actualizado {formatDate(d.updated)}</span>}
          <span><Icon name="clock" size={17} />{readingTime(entry.body)} min de lectura</span>
        </div>
      </div>
    </header>

    <div class="container layout">
      <div class="prose">
        <Content />
      </div>

      <aside class="side">
        <div class="box">
          <h2>Ficha</h2>
          <dl>
            <dt>Tipo</dt><dd>{TYPE_LABEL[d.type]}</dd>
            <dt>Categoría</dt><dd><a href={`/categoria/${d.category}/`}>{cat.name}</a></dd>
            {d.type === 'laboratorio' && (<><dt>Plataforma</dt><dd>{d.platform}</dd></>)}
            <dt>Dificultad</dt><dd>{d.difficulty}</dd>
          </dl>
          {
            d.tools.length > 0 && (
              <>
                <h3><Icon name="wrench" size={15} /> Herramientas</h3>
                <ul class="chips">{d.tools.map((t) => <li>{t}</li>)}</ul>
              </>
            )
          }
          {
            d.tags.length > 0 && (
              <>
                <h3><Icon name="tag" size={15} /> Etiquetas</h3>
                <ul class="chips">{d.tags.map((t) => <li><a href={`/recursos/?q=${encodeURIComponent(t)}`}>#{t}</a></li>)}</ul>
              </>
            )
          }
          {
            d.labUrl && (
              <a href={d.labUrl} target="_blank" rel="noopener" class="btn btn-primary lab-btn">
                Ir al laboratorio <Icon name="external" size={16} />
              </a>
            )
          }
        </div>

        {
          toc.length > 0 && (
            <nav class="box toc" aria-label="Índice">
              <h2>Contenido</h2>
              <ol>
                {toc.map((h) => (
                  <li class={`d${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
    </div>

    <nav class="container pager" aria-label="Más recursos">
      {
        older ? (
          <a href={`/recursos/${older.id}/`} class="pg">
            <span><Icon name="arrow-left" size={16} /> Anterior</span>
            <strong>{older.data.title}</strong>
          </a>
        ) : <span />
      }
      {
        newer && (
          <a href={`/recursos/${newer.id}/`} class="pg next">
            <span>Siguiente <Icon name="arrow-right" size={16} /></span>
            <strong>{newer.data.title}</strong>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .post-head {
    padding: 44px 0 36px;
    border-bottom: 1px solid var(--border);
    background-color: var(--bg-2);
  }

  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 18px;
  }

  .crumbs a:hover {
    color: var(--accent-2);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .badges :global(.badge svg) {
    color: var(--accent-2);
  }

  .draft {
    color: var(--amber);
    border-color: rgba(245, 184, 61, 0.55);
  }

  h1 {
    font-size: clamp(32px, 5vw, 50px);
    font-weight: 800;
    margin: 18px 0 12px;
    max-width: 22ch;
  }

  .desc {
    font-size: 19px;
    color: var(--text-2);
    max-width: 62ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 20px;
    color: var(--muted);
    font-size: 14.5px;
  }

  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 56px;
    margin-top: 44px;
    align-items: start;
  }

  .side {
    position: sticky;
    top: 92px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .box {
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .box h2 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin-bottom: 14px;
  }

  .box h3 {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    color: var(--text-2);
    margin: 18px 0 10px;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 14px;
    margin: 0;
    font-size: 14.5px;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    text-align: right;
  }

  dd a:hover {
    color: var(--accent-2);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chips li {
    padding: 3px 10px;
    font-size: 13px;
    border-radius: 7px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-2);
  }

  .chips a:hover {
    color: var(--accent-2);
  }

  .lab-btn {
    width: 100%;
    justify-content: center;
    margin-top: 20px;
    padding: 11px 16px;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 50vh;
    overflow: auto;
  }

  .toc a {
    display: block;
    padding: 5px 10px;
    border-left: 2px solid var(--border);
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.4;
  }

  .toc .d3 a {
    padding-left: 22px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .toc a:hover,
  .toc a.current {
    color: var(--accent-2);
    border-left-color: var(--accent-2);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 64px;
  }

  .pg {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s;
  }

  .pg:hover {
    border-color: var(--accent);
  }

  .pg span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .pg.next {
    text-align: right;
    align-items: flex-end;
  }

  @media (max-width: 980px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .side {
      position: static;
      order: -1;
    }
    .toc {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Resalta en el índice la sección que se está leyendo
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          links.forEach((l) => l.classList.remove('current'));
          map.get(e.target.id)?.classList.add('current');
        }
      }
    },
    { rootMargin: '-90px 0px -70% 0px' },
  );
  document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((h) => obs.observe(h));
</script>
