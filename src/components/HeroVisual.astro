---
import Icon from './Icon.astro';
---

<div class="visual" aria-hidden="true">
  <div class="halo"></div>

  <div class="win term">
    <div class="win-bar">
      <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
      <span class="win-title">analyst@parrot: ~/labs</span>
    </div>
    <pre><span class="p">$</span> tshark -r capture.pcap -Y <span class="s">"smb2 || ntlmssp"</span>
<span class="c">  142  10.0.0.130 → 10.0.0.133  NTLMSSP_AUTH</span>
<span class="c">  157  10.0.0.130 → 10.0.0.133  SMB2 Create PSEXESVC</span>
<span class="p">$</span> vol -f mem.raw windows.pstree
<span class="c">  4      System</span>
<span class="c">  └─ 732  services.exe</span>
<span class="w">     └─ 2148 PSEXESVC.exe   ⚠ sospechoso</span>
<span class="p">$</span> sha256sum sample.exe | vt lookup
<span class="r">  [!] 58/72 motores · Trojan.Stealer</span>
<span class="p">$</span> <span class="cursor"></span></pre>
  </div>

  <div class="win alert">
    <div class="alert-icon"><Icon name="target" size={22} /></div>
    <div>
      <strong>IOC detectado</strong>
      <span>45.126.209.4 · C2 beacon</span>
    </div>
  </div>

  <div class="shield">
    <svg viewBox="0 0 120 136" fill="none">
      <path
        d="M60 6c13 10 28 15 46 15v40c0 32-19 52-46 68C33 113 14 93 14 61V21c18 0 33-5 46-15Z"
        stroke="currentColor"
        stroke-width="5"
        stroke-linejoin="round"></path>
      <path d="m48 56-14 14 14 14M72 56l14 14-14 14M64 50 56 90" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>

  <div class="win stats">
    <div class="bars">
      {[40, 65, 30, 80, 55, 95, 45, 70, 35, 60].map((h) => <span style={`height:${h}%`} />)}
    </div>
    <span class="stats-label">Eventos / min</span>
  </div>
</div>

<style>
  .visual {
    position: relative;
    height: 100%;
    min-height: 360px;
  }

  .halo {
    position: absolute;
    inset: 10% 5% 0 15%;
    background: radial-gradient(circle at 55% 50%, rgba(31, 139, 255, 0.35), transparent 62%);
    filter: blur(20px);
  }

  .win {
    position: absolute;
    background: rgba(8, 18, 34, 0.92);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(43, 212, 245, 0.06);
  }

  .term {
    top: 8%;
    left: 4%;
    width: 76%;
    overflow: hidden;
    animation: float 7s ease-in-out infinite;
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    background: rgba(14, 28, 50, 0.7);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.r { background: #ff5f57; }
  .dot.y { background: #febc2e; }
  .dot.g { background: #28c840; }

  .win-title {
    margin-left: 10px;
    font: 12px var(--mono);
    color: var(--muted);
  }

  pre {
    margin: 0;
    padding: 16px 18px 18px;
    font: 12.5px/1.75 var(--mono);
    color: var(--text-2);
    white-space: pre;
    overflow: hidden;
  }

  .p { color: var(--accent-2); }
  .s { color: #a5e3a0; }
  .c { color: #7f93b5; }
  .w { color: var(--amber); }
  .r { color: var(--red); }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    vertical-align: -3px;
    background: var(--accent-2);
    animation: blink 1.1s steps(1) infinite;
  }

  .alert {
    right: 2%;
    top: 2%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-color: rgba(255, 93, 108, 0.45);
    animation: float 6s ease-in-out infinite reverse;
  }

  .alert-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--red-soft);
    color: var(--red);
  }

  .alert strong {
    display: block;
    font-size: 14px;
  }

  .alert span {
    font: 12px var(--mono);
    color: var(--muted);
  }

  .shield {
    position: absolute;
    right: 8%;
    bottom: 6%;
    width: 130px;
    color: var(--accent);
    filter: drop-shadow(0 0 22px rgba(31, 139, 255, 0.85));
    animation: float 8s ease-in-out infinite;
  }

  .stats {
    left: 34%;
    bottom: -4%;
    padding: 14px 16px 10px;
    width: 200px;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 50px;
  }

  .bars span {
    flex: 1;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(var(--accent-2), rgba(31, 139, 255, 0.35));
  }

  .stats-label {
    display: block;
    margin-top: 6px;
    font: 11px var(--mono);
    color: var(--muted);
  }

  @keyframes float {
    50% { transform: translateY(-8px); }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .term, .alert, .shield { animation: none; }
  }

  @media (max-width: 560px) {
    .visual { min-height: 320px; }
    .term { width: 92%; left: 0; }
    pre { font-size: 10.5px; }
    .alert { top: auto; bottom: 30%; right: 0; }
    .stats { display: none; }
    .shield { width: 90px; right: 4%; }
  }
</style>
