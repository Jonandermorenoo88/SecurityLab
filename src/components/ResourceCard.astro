---
import Icon from './Icon.astro';
import { CATEGORIES } from '../config';
import { formatDate, TYPE_ICON, TYPE_LABEL, type Recurso } from '../lib/recursos';

interface Props {
  entry: Recurso;
}

const { entry } = Astro.props;
const d = entry.data;
const cat = CATEGORIES[d.category];

// Icono grande de la tarjeta: según el tema si lo reconocemos, si no el de la categoría.
const topicIcons: Record<string, Parameters<typeof Icon>[0]['name']> = {
  malware: 'bug',
  redes: 'network',
  red: 'network',
  android: 'smartphone',
  móvil: 'smartphone',
  memoria: 'monitor',
  'threat intel': 'target',
};
const artIcon = (d.topic && topicIcons[d.topic.toLowerCase()]) || cat.icon;
const diffClass = { Fácil: 'badge-easy', Medio: 'badge-medium', Difícil: 'badge-hard' }[d.difficulty];

// Barras de "onda" pseudoaleatorias pero estables para cada entrada
let seed = [...entry.id].reduce((a, c) => a + c.charCodeAt(0), 0);
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const bars = Array.from({ length: 28 }, (_, i) => {
  const env = Math.sin((i / 27) * Math.PI);
  return 4 + Math.round(env * (8 + rand() * 30));
});
---

<a href={`/recursos/${entry.id}/`} class="card" data-category={d.category}>
  <div class="art">
    <div class="art-grid"></div>
    <svg class="wave" viewBox="0 0 168 60" preserveAspectRatio="none" aria-hidden="true">
      {bars.map((h, i) => <rect x={i * 6} y={30 - h / 2} width="2" height={h} rx="1" />)}
    </svg>
    <svg class="nodes" viewBox="0 0 120 80" aria-hidden="true">
      <path d="M10 60 L38 22 L70 40 L104 14 M38 22 L56 70 L70 40 M70 40 L110 62" />
      <circle cx="10" cy="60" r="3" /><circle cx="38" cy="22" r="4" /><circle cx="70" cy="40" r="4.5" />
      <circle cx="104" cy="14" r="3" /><circle cx="56" cy="70" r="3" /><circle cx="110" cy="62" r="3.5" />
    </svg>
    <div class="art-icon"><Icon name={artIcon} size={76} strokeWidth={1.3} /></div>

    <span class:list={['badge', d.type === 'guia' ? 'badge-guide' : 'badge-lab', 'tl']}>
      <Icon name={TYPE_ICON[d.type]} size={15} />
      {TYPE_LABEL[d.type]}
    </span>
    {
      d.type === 'laboratorio' && (
        <span class="badge tr">
          <Icon name="shield-check" size={15} />
          {d.platform}
        </span>
      )
    }
    {d.draft && <span class="badge draft">Borrador</span>}
  </div>

  <div class="body">
    <h3>{d.title}</h3>
    <p>{d.description}</p>
    <div class="meta">
      <span class="date"><Icon name="calendar" size={16} />{formatDate(d.date)}</span>
      {d.topic && <span class="badge badge-muted"><Icon name="tag" size={14} />{d.topic}</span>}
      <span class:list={['badge', diffClass]}>{d.difficulty}</span>
      <span class="go" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -18px rgba(31, 139, 255, 0.45);
  }

  .art {
    position: relative;
    height: 128px;
    overflow: hidden;
    background: radial-gradient(ellipse 60% 90% at 40% 100%, rgba(31, 139, 255, 0.28), transparent 70%),
      linear-gradient(180deg, #06101f, #081629);
    border-bottom: 1px solid var(--border);
  }

  .art-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(43, 212, 245, 0.18) 1px, transparent 1px);
    background-size: 14px 14px;
    mask-image: linear-gradient(90deg, transparent, #000 40%, #000 60%, transparent);
    opacity: 0.6;
  }

  .art-icon {
    position: absolute;
    left: 50%;
    top: 54%;
    transform: translate(-50%, -50%);
    color: var(--accent-2);
    filter: drop-shadow(0 0 14px rgba(43, 212, 245, 0.7));
  }

  .wave {
    position: absolute;
    right: 16px;
    top: 50%;
    width: 150px;
    height: 54px;
    transform: translateY(-30%);
    fill: var(--accent-2);
    opacity: 0.55;
  }

  .nodes {
    position: absolute;
    left: 18px;
    bottom: 6px;
    width: 120px;
    opacity: 0.55;
    stroke: var(--accent-2);
    stroke-width: 0.8;
    fill: none;
  }

  .nodes circle {
    fill: var(--accent-2);
    stroke: none;
  }

  .tl,
  .tr,
  .draft {
    position: absolute;
    top: 12px;
    z-index: 1;
  }

  .tl {
    left: 14px;
  }

  .tr {
    right: 14px;
  }

  .tr :global(svg) {
    color: var(--accent-2);
  }

  .draft {
    left: 50%;
    transform: translateX(-50%);
    color: var(--amber);
    border-color: rgba(245, 184, 61, 0.55);
    background: rgba(40, 28, 6, 0.9);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 22px 20px;
    flex: 1;
  }

  h3 {
    font-size: 20px;
    font-weight: 800;
  }

  .body > p {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: 10px;
  }

  .date {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    color: var(--text-2);
    margin-right: 4px;
  }

  .go {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 38px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--accent);
    color: var(--accent-2);
    transition: background 0.2s, color 0.2s;
  }

  .card:hover .go {
    background: var(--accent);
    color: #fff;
  }
</style>
